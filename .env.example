# Copy to .env and fill in.

# --- required ---
FRIGATE_URL=http://192.168.10.106:5000

MQTT_HOST=192.168.10.103
MQTT_PORT=1883
MQTT_USER=mqtt
MQTT_PASS=REPLACE_ME

# HA's /config share is mounted on the host by autofs at /mnt/hass
# (/etc/auto.smb.shares, creds in /home/josh/.smb.hass) — no SMB vars here.

# --- optional (defaults shown) ---
# CAMERAS=doorbell
# LABELS=person
# REQUIRED_ZONE=property
# IGNORE_SUBLABELS=Josh
# GIF_FPS=8
# GIF_WIDTH=480
# GIF_MAX_SECONDS=6
# GIF_SPEEDUP=3.0    # wall-clock playback speedup (3.0 = motion looks 3x faster)
# GIF_RETENTION_HOURS=24
# CLIP_FETCH_TIMEOUT_S=45
# LOG_LEVEL=INFO
